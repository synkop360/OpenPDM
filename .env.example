OPENPDM_ENV=development
OPENPDM_API_HOST=0.0.0.0
OPENPDM_API_PORT=8000
OPENPDM_BACKEND_HOST_PORT=18000
# Frontend: when running Vite against python scripts/dev.py run-backend, set:
# VITE_API_PROXY_TARGET=http://localhost:8000
OPENPDM_DATABASE_URL=postgresql+psycopg://openpdm:openpdm@postgres:5432/openpdm
OPENPDM_S3_ENDPOINT_URL=http://minio:9000
OPENPDM_S3_BUCKET=openpdm-blobs
OPENPDM_S3_ACCESS_KEY=openpdm
OPENPDM_S3_SECRET_KEY=openpdm-secret
OPENPDM_AUDIT_GRAPH_QUERIES=false
OPENPDM_PLUGIN_PACKAGE_ROOT=.openpdm-data/plugins
# Optional directory for Wasmtime's compiled-artifact cache. When set, a cold
# component compile (seconds for a CPython-based plugin) becomes a warm
# deserialize (milliseconds) on later invocations, so a first enable/analyze
# does not race OPENPDM_PLUGIN_RUNTIME_TIMEOUT_SECONDS. Leave unset to disable.
OPENPDM_PLUGIN_RUNTIME_CACHE_DIR=.openpdm-data/plugin-cache
OPENPDM_PLUGIN_RUNTIME_TIMEOUT_SECONDS=5
OPENPDM_PLUGIN_RUNTIME_FUEL=25000000
OPENPDM_PLUGIN_ANALYSIS_PROVIDER_FUEL=200000000
OPENPDM_PLUGIN_RUNTIME_MEMORY_BYTES=67108864
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OPENPDM_PLUGIN_CONFIGURATION_KEY=
# Used only by scripts/seed_official_plugins.py to register/sign in as the
# Platform Administrator that installs and enables the default Official Plugins.
OPENPDM_SEED_ADMIN_EMAIL=admin@openpdm.local
OPENPDM_SEED_ADMIN_PASSWORD=openpdm-seed-admin-1
OPENPDM_SEED_ADMIN_DISPLAY_NAME=Platform Administrator
MINIO_ROOT_USER=openpdm
MINIO_ROOT_PASSWORD=openpdm-secret
POSTGRES_DB=openpdm
POSTGRES_USER=openpdm
POSTGRES_PASSWORD=openpdm
