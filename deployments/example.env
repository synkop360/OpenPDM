# Example named deployment for the OpenPDM launcher.
#
# Copy this file to deployments/<name>.env (or, easier, let the launcher
# generate it: `python scripts/start_all.py --new-deployment`, or the
# "New deployment…" button in `python scripts/start_all.py --gui`).
#
# A named deployment is one isolated Compose stack: its own Compose project
# (so containers, network and volumes never collide), its own published host
# ports, and its own blob storage target. Run real work on one deployment and
# throwaway/test work on another; neither can touch the other's data.
#
# Every "*.env" in this directory is git-ignored except this example.

# --- identity -------------------------------------------------------------
OPENPDM_DEPLOYMENT_NAME=example
OPENPDM_DEPLOYMENT_PROJECT=openpdm-example
# bundled | s3 | local
OPENPDM_DEPLOYMENT_STORAGE_KIND=bundled

# --- published host ports (keep every deployment's block distinct) -------
OPENPDM_BACKEND_HOST_PORT=18010
OPENPDM_FRONTEND_HOST_PORT=5183
OPENPDM_PG_HOST_PORT=5442
OPENPDM_MINIO_HOST_PORT=9010
OPENPDM_MINIO_CONSOLE_HOST_PORT=9011

# --- blob storage -------------------------------------------------------
# bundled: point at this deployment's own MinIO container.
OPENPDM_S3_ENDPOINT_URL=http://minio:9000
OPENPDM_S3_BUCKET=openpdm-blobs
OPENPDM_S3_ACCESS_KEY=openpdm
OPENPDM_S3_SECRET_KEY=openpdm-secret
AWS_DEFAULT_REGION=us-east-1
#
# s3: point at an external S3-compatible bucket instead, e.g.
#   OPENPDM_S3_ENDPOINT_URL=https://s3.gra.io.cloud.ovh.net
#   OPENPDM_S3_BUCKET=my-org-blobs
#   OPENPDM_S3_ACCESS_KEY=...
#   OPENPDM_S3_SECRET_KEY=...
#   AWS_DEFAULT_REGION=gra
#
# local: keep blobs on the filesystem. Set the endpoint to a file:// URL and
# choose a volume name or absolute host path for the bind mount:
#   OPENPDM_S3_ENDPOINT_URL=file:///var/lib/openpdm/blobs
#   OPENPDM_BLOB_LOCAL_SOURCE=openpdm-example-blobs

# --- database / MinIO root creds --------------------------------------
POSTGRES_DB=openpdm
POSTGRES_USER=openpdm
POSTGRES_PASSWORD=openpdm
MINIO_ROOT_USER=openpdm
MINIO_ROOT_PASSWORD=openpdm-secret
